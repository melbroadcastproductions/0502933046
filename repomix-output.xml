    #[serde(rename = "prevDayPx", deserialize_with = "de_string_to_number")]
    prev_day_price: f64,
}

impl HyperliquidAssetContext {
    fn price(&self) -> f64 {
        if self.mid_price > 0.0 {
            self.mid_price
        } else {
            self.mark_price
        }
    }
}

#[derive(Debug, Deserialize)]
#[allow(dead_code)]
struct HyperliquidKline {
